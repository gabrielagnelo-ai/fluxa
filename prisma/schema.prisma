generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum CategoryLimitType {
  FIXED
  VARIABLE
  GOAL
}

enum InvestmentAssetType {
  FIXED_INCOME
  STOCK
  FII
  ETF
  FUND
  CRYPTO
  CASH
  OTHER
}

enum ConsentStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
  ERROR
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  REJECTED
  FAILED
}

enum WhatsAppMessageStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

model User {
  id           String        @id @default(uuid())
  supabaseId   String        @unique
  name         String?
  email        String        @unique
  transactions Transaction[]
  categories   Category[]
  budgets      Budget[]
  investments  InvestmentAsset[]
  balanceBaseline BalanceBaseline?
  categoryLimits CategoryLimit[]
  plannedExpenses PlannedExpense[]
  spendingPlans SpendingPlan[]
  goals        Goal[]
  goalMarkers  GoalMarker[]
  goalContributions GoalContribution[]
  bankConnections BankConnection[]
  consents     OpenFinanceConsent[]
  webhookEvents WebhookEvent[]
  whatsappLinks WhatsAppLink[]
  whatsappMessages WhatsAppMessage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model BalanceBaseline {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("balance_baselines")
}

model WhatsAppLink {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneHash     String   @unique
  phoneLast4    String?
  displayName   String?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@map("whatsapp_links")
}

model WhatsAppMessage {
  id              String                @id @default(uuid())
  userId          String?
  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  providerMessageId String              @unique
  phoneHash       String
  direction       String
  textRedacted    String?
  status          WhatsAppMessageStatus @default(RECEIVED)
  error           String?
  transactionId   String?
  createdAt       DateTime              @default(now())
  processedAt     DateTime?

  @@index([phoneHash, createdAt])
  @@map("whatsapp_messages")
}

model BankConnection {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  institutionName String?
  accountMask     String?
  linkIdHash      String?
  status          ConsentStatus @default(PENDING)
  lastSyncedAt     DateTime?
  disconnectedAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId, provider])
  @@map("bank_connections")
}

model OpenFinanceConsent {
  id              String        @id @default(uuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String
  belvoLinkIdHash String?
  status          ConsentStatus @default(PENDING)
  scopes          String[]      @default([])
  createdAt       DateTime      @default(now())
  revokedAt       DateTime?
  expiresAt       DateTime?

  @@index([userId, provider, status])
  @@map("open_finance_consents")
}

model WebhookEvent {
  id                 String        @id @default(uuid())
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider           String
  eventId            String
  eventType          String
  processedAt        DateTime?
  rawPayloadRedacted Json?
  status             WebhookStatus @default(RECEIVED)
  createdAt          DateTime      @default(now())

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@map("webhook_events")
}

model InvestmentAsset {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  ticker         String?
  type           InvestmentAssetType
  institution    String?
  quantity       Decimal?            @db.Decimal(18, 8)
  averagePrice   Decimal?            @db.Decimal(12, 2)
  investedAmount Decimal             @db.Decimal(12, 2)
  currentAmount  Decimal             @db.Decimal(12, 2)
  acquiredAt     DateTime?
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId, type])
  @@map("investment_assets")
}

model Category {
  id           String        @id @default(uuid())
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  color        String
  icon         String
  keywords     String[]      @default([])
  transactions Transaction[]
  budgets      Budget[]
  categoryLimits CategoryLimit[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name])
  @@map("categories")
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date        DateTime
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  source      String?
  importId    String?
  categoryLocked Boolean      @default(false)
  goalContributions GoalContribution[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, date])
  @@index([categoryId])
  @@map("transactions")
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  month      Int
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

model CategoryLimit {
  id         String            @id @default(uuid())
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal           @db.Decimal(12, 2)
  type       CategoryLimitType @default(VARIABLE)
  month      Int
  year       Int
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
  @@map("category_limits")
}

model PlannedExpense {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  amount    Decimal           @db.Decimal(12, 2)
  type      CategoryLimitType @default(VARIABLE)
  month     Int
  year      Int
  note      String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId, year, month])
  @@map("planned_expenses")
}

model SpendingPlan {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month          Int
  year           Int
  monthlyIncome  Decimal  @db.Decimal(12, 2)
  model          String
  needsPercent   Int
  wantsPercent   Int
  savingsPercent Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId, year, month])
  @@map("spending_plans")
}

model Goal {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetAmount  Decimal    @db.Decimal(12, 2)
  currentAmount Decimal    @default(0) @db.Decimal(12, 2)
  dueDate       DateTime?
  status        GoalStatus @default(ACTIVE)
  markers       GoalMarker[]
  contributions GoalContribution[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("goals")
}

model GoalMarker {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  keyword   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, keyword])
  @@index([goalId])
  @@map("goal_markers")
}

model GoalContribution {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId        String
  goal          Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount        Decimal     @db.Decimal(12, 2)
  date          DateTime
  createdAt     DateTime    @default(now())

  @@unique([goalId, transactionId])
  @@index([userId, date])
  @@map("goal_contributions")
}
